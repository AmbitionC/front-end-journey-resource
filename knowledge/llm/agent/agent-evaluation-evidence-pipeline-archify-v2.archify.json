{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Agent 评估：可复现证据流程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "animation": "none",
    "legend": { "mode": "hidden" },
    "viewBox": [1200, 630]
  },
  "lanes": [
    { "id": "prepare_run_rules", "label": "冻结、执行与终态规则" },
    { "id": "judge_slices", "label": "必要评审与风险切片" },
    { "id": "compare_archive", "label": "比较与可复现记录" }
  ],
  "nodes": [
    { "id": "freeze_task_environment", "lane": "prepare_run_rules", "col": 0, "type": "database", "label": "冻结任务集与环境版本", "sublabel": "同一基准与运行条件", "width": 250, "height": 78 },
    { "id": "run_record_evidence", "lane": "prepare_run_rules", "col": 1, "type": "backend", "label": "运行 Agent", "sublabel": "记录输出与完整轨迹", "width": 250, "height": 78 },
    { "id": "check_environment_state", "lane": "prepare_run_rules", "col": 2, "type": "security", "label": "规则判定环境终态", "sublabel": "不只检查最终文本", "width": 250, "height": 78 },
    { "id": "calibrated_judge_if_needed", "lane": "judge_slices", "col": 2, "type": "backend", "label": "必要时运行 Judge", "sublabel": "人工集校准；固定模型与 Prompt 版本", "width": 250, "height": 78 },
    { "id": "scenario_risk_slices", "lane": "judge_slices", "col": 1, "type": "cloud", "label": "按场景与风险切片", "sublabel": "保留不同能力域的失败明细", "width": 250, "height": 78 },
    { "id": "compare_quality_cost_latency", "lane": "compare_archive", "col": 1, "type": "database", "label": "比较质量、成本与延迟", "sublabel": "同任务集与价格快照；不只看准确率", "width": 250, "height": 78 },
    { "id": "archive_configuration_failures", "lane": "compare_archive", "col": 2, "type": "database", "label": "保存运行配置与失败样本", "sublabel": "版本、轨迹、结果与失败分类可追溯", "width": 250, "height": 78 }
  ],
  "edges": [
    { "id": "freeze_then_run", "from": "freeze_task_environment", "to": "run_record_evidence", "role": "main" },
    { "id": "run_then_rules", "from": "run_record_evidence", "to": "check_environment_state", "role": "main" },
    { "id": "rules_then_optional_judge", "from": "check_environment_state", "to": "calibrated_judge_if_needed", "role": "main" },
    { "id": "judge_then_slices", "from": "calibrated_judge_if_needed", "to": "scenario_risk_slices", "role": "main" },
    { "id": "slices_then_compare", "from": "scenario_risk_slices", "to": "compare_quality_cost_latency", "role": "main" },
    { "id": "compare_then_archive", "from": "compare_quality_cost_latency", "to": "archive_configuration_failures", "role": "main" }
  ],
  "semanticChecks": {
    "requiredEdges": [
      { "from": "freeze_task_environment", "to": "run_record_evidence" },
      { "from": "run_record_evidence", "to": "check_environment_state" },
      { "from": "check_environment_state", "to": "calibrated_judge_if_needed" },
      { "from": "calibrated_judge_if_needed", "to": "scenario_risk_slices" },
      { "from": "scenario_risk_slices", "to": "compare_quality_cost_latency" },
      { "from": "compare_quality_cost_latency", "to": "archive_configuration_failures" }
    ]
  }
}
