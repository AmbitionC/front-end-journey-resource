      "id": "signal",
      "from": "aqs",
      "to": "waiter",
      "y": 290,
      "label": "归零：unpark 等待者"
    },
    {
      "id": "retry-entry",
      "from": "waiter",
      "to": "aqs",
      "y": 350,
      "label": "醒来后重试获取"
