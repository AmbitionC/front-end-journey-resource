  "cards": [
    {
      "dot": "cyan",
      "title": "ZSet 为什么不必照搬 B+ 树",
      "items": [
        "内存中的 member 定位与有序范围访问由两种结构分工。",
        "跳表用多层链接跨越成员；底层链负责顺序遍历。"
      ]
    },
    {
      "dot": "emerald",
      "title": "InnoDB 为什么采用页式树",
      "items": [
        "一页容纳多键与指针，让每次页面访问完成更多导航。",
        "范围定位后沿叶页链读取；缓存命中会改变实际 I/O。"
      ]
    },
    {
      "dot": "slate",
      "title": "结构示意的边界",
      "items": [
        "实线表示 forward 导航或叶链；虚线只表示同一成员 / 节点的视图关联。",
        "页容量与跳表层高仅为教学示意；不比较性能胜负。"
      ]
    }
  ]
